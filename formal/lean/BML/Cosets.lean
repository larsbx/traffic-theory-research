import BML.Ring
import BML.Congruence

/-!
Diagonal motion on the actual positive finite torus. The diagonal step is the
east coordinate's successor together with the north coordinate's predecessor.
Its orbits are exactly the classes of x+y modulo gcd(width,height).
-/
namespace BML

/-- The phase class relevant to opposite-species encounters in free motion. -/
def phaseClass (w h : Nat) (p : Position w h) : Nat :=
  (p.1.val + p.2.val) % Nat.gcd w h

/-- One actual cyclic displacement by (1,-1). -/
def diagonalStep (w h : Nat) (hw : 0 < w) (hh : 0 < h)
    (p : Position w h) : Position w h :=
  (cyclicNext w hw p.1, cyclicPrev h hh p.2)

/-- Integer translation in one cyclic coordinate, including negative times. -/
def cyclicShift (n : Nat) (hn : 0 < n) (t : Int) (i : Fin n) : Fin n :=
  ⟨(((i.val : Int) + t) % (n : Int)).toNat, by
    have hzero := Int.emod_nonneg ((i.val : Int) + t) (by omega : (n : Int) ≠ 0)
    have hlt := Int.emod_lt_of_pos ((i.val : Int) + t) (by omega : (0 : Int) < n)
    omega⟩

@[simp] theorem cyclicShift_val_int (n : Nat) (hn : 0 < n) (t : Int) (i : Fin n) :
    ((cyclicShift n hn t i).val : Int) = ((i.val : Int) + t) % (n : Int) := by
  have hzero := Int.emod_nonneg ((i.val : Int) + t) (by omega : (n : Int) ≠ 0)
  simp only [cyclicShift]
  omega

@[simp] theorem cyclicShift_zero (n : Nat) (hn : 0 < n) (i : Fin n) :
    cyclicShift n hn 0 i = i := by
  apply Fin.ext
  have hi := i.isLt
  have hv := cyclicShift_val_int n hn 0 i
  have hm : (i.val : Int) % n = i.val := Int.emod_eq_of_lt (by omega) (by omega)
  simp only [Int.add_zero, hm] at hv
  omega

/-- Integer translations form an action on the existing finite coordinate. -/
theorem cyclicShift_add (n : Nat) (hn : 0 < n) (a b : Int) (i : Fin n) :
    cyclicShift n hn a (cyclicShift n hn b i) = cyclicShift n hn (a + b) i := by
  apply Fin.ext
  apply Int.ofNat_inj.mp
  simp only [cyclicShift_val_int, Int.emod_add_emod]
  congr 1
  omega

@[simp] theorem cyclicShift_one (n : Nat) (hn : 0 < n) (i : Fin n) :
    cyclicShift n hn 1 i = cyclicNext n hn i := by
  apply Fin.ext
  apply Int.ofNat_inj.mp
  rw [cyclicShift_val_int, cyclicNext_val]
  simp

@[simp] theorem cyclicShift_neg_one (n : Nat) (hn : 0 < n) (i : Fin n) :
    cyclicShift n hn (-1) i = cyclicPrev n hn i := by
  have he := cyclicShift_add n hn 1 (-1) i
  simp only [Int.reduceAdd, cyclicShift_zero, cyclicShift_one] at he
  have hp := congrArg (cyclicPrev n hn) he
  simpa only [cyclicPrev_next] using hp

/-- Signed action generated by the diagonal displacement (1,-1). -/
def diagonalShift (w h : Nat) (hw : 0 < w) (hh : 0 < h)
    (t : Int) (p : Position w h) : Position w h :=
  (cyclicShift w hw t p.1, cyclicShift h hh (-t) p.2)

@[simp] theorem diagonalShift_zero (w h : Nat) (hw : 0 < w) (hh : 0 < h)
    (p : Position w h) : diagonalShift w h hw hh 0 p = p := by
  simp [diagonalShift]

theorem diagonalShift_add (w h : Nat) (hw : 0 < w) (hh : 0 < h)
    (a b : Int) (p : Position w h) :
    diagonalShift w h hw hh a (diagonalShift w h hw hh b p) =
      diagonalShift w h hw hh (a + b) p := by
  simp [diagonalShift, cyclicShift_add, Int.neg_add]

@[simp] theorem diagonalShift_one (w h : Nat) (hw : 0 < w) (hh : 0 < h)
    (p : Position w h) : diagonalShift w h hw hh 1 p = diagonalStep w h hw hh p := by
  simp [diagonalShift, diagonalStep]

/-- The signed arithmetic action agrees with iteration of the actual cyclic step. -/
theorem iterate_diagonalStep (w h : Nat) (hw : 0 < w) (hh : 0 < h)
    (t : Nat) (p : Position w h) :
    iterate (diagonalStep w h hw hh) t p = diagonalShift w h hw hh (t : Int) p := by
  induction t with
  | zero => simp [iterate]
  | succ t ih =>
      rw [iterate, ih, ← diagonalShift_one, diagonalShift_add]
      congr 1
      omega

/-- Equality of translated coordinates, expressed without a Fin cast. -/
theorem cyclicShift_eq_iff (n : Nat) (hn : 0 < n) (t : Int) (i j : Fin n) :
    cyclicShift n hn t i = j ↔ ((i.val : Int) + t) % (n : Int) = j.val := by
  constructor
  · intro he
    have hv := congrArg (fun k : Fin n => (k.val : Int)) he
    simpa only [cyclicShift_val_int] using hv
  · intro he
    apply Fin.ext
    have hv := cyclicShift_val_int n hn t i
    omega

/-- A coordinate reaches j exactly at times congruent to j-i. -/
theorem cyclicShift_eq_iff_mod (n : Nat) (hn : 0 < n) (t : Int) (i j : Fin n) :
    cyclicShift n hn t i = j ↔ t % (n : Int) = ((j.val : Int) - i.val) % n := by
  rw [cyclicShift_eq_iff]
  have hj := j.isLt
  have he : ((i.val : Int) + ((j.val : Int) - i.val)) % n = j.val := by
    have hx : (i.val : Int) + ((j.val : Int) - i.val) = j.val := by omega
    rw [hx]
    exact Int.emod_eq_of_lt (by omega) (by omega)
  constructor
  · intro hm
    apply (Int.emod_add_cancel_left (i := (i.val : Int))).mp
    exact hm.trans he.symm
  · intro hm
    exact ((Int.emod_add_cancel_left (i := (i.val : Int))).mpr hm).trans he

theorem cyclicShift_neg_eq_iff (n : Nat) (hn : 0 < n) (t : Int) (i j : Fin n) :
    cyclicShift n hn (-t) i = j ↔ (((j.val : Int) - i.val) + t) % n = 0 := by
  rw [cyclicShift_eq_iff_mod]
  constructor
  · intro hm
    have hz := Int.emod_eq_emod_iff_emod_sub_eq_zero.mp hm.symm
    simpa only [Int.sub_neg] using hz
  · intro hz
    apply Eq.symm
    apply Int.emod_eq_emod_iff_emod_sub_eq_zero.mpr
    simpa only [Int.sub_neg] using hz

/-- The signed action solves exactly the two congruences in the Bézout lemma. -/
theorem diagonalShift_eq_iff (w h : Nat) (hw : 0 < w) (hh : 0 < h)
    (t : Int) (p q : Position w h) :
    diagonalShift w h hw hh t p = q ↔
      t % (w : Int) = ((q.1.val : Int) - p.1.val) % w ∧
        (((q.2.val : Int) - p.2.val) + t) % h = 0 := by
  change (cyclicShift w hw t p.1, cyclicShift h hh (-t) p.2) = q ↔ _
  rw [Prod.ext_iff, cyclicShift_eq_iff_mod, cyclicShift_neg_eq_iff]

/-- Two phase classes agree exactly when their signed coordinate differences
sum to zero modulo the gcd. -/
theorem phaseClass_eq_iff (w h : Nat) (p q : Position w h) :
    phaseClass w h p = phaseClass w h q ↔
      (((q.1.val : Int) - p.1.val) + ((q.2.val : Int) - p.2.val)) %
        (Nat.gcd w h : Int) = 0 := by
  have hd : ((q.1.val : Int) - p.1.val) + ((q.2.val : Int) - p.2.val) =
      ((q.1.val : Int) + q.2.val) - ((p.1.val : Int) + p.2.val) := by omega
  rw [hd]
  constructor
  · intro he
    have hc := congrArg (fun n : Nat => (n : Int)) he.symm
    simp only [phaseClass, Int.natCast_emod, Int.natCast_add] at hc
    exact Int.emod_eq_emod_iff_emod_sub_eq_zero.mp hc
  · intro hz
    have hc := (Int.emod_eq_emod_iff_emod_sub_eq_zero.mpr hz).symm
    apply Int.ofNat_inj.mp
    simpa only [phaseClass, Int.natCast_emod, Int.natCast_add] using hc

/-- Full coset identity: each phase-class fiber is precisely one signed
diagonal orbit, with no assumption of coprime side lengths. -/
theorem diagonalShift_exists_iff (w h : Nat) (hw : 0 < w) (hh : 0 < h)
    (p q : Position w h) :
    (∃ t : Int, diagonalShift w h hw hh t p = q) ↔
      phaseClass w h p = phaseClass w h q := by
  rw [phaseClass_eq_iff, coset_int_iff w h hw hh]
  apply exists_congr
  intro t
  exact diagonalShift_eq_iff w h hw hh t p q

/-- Kernel form of the identity at the origin. -/
theorem diagonal_kernel_iff (w h : Nat) (hw : 0 < w) (hh : 0 < h)
    (q : Position w h) :
    (∃ t : Int, diagonalShift w h hw hh t (⟨0, hw⟩, ⟨0, hh⟩) = q) ↔
      phaseClass w h q = 0 := by
  rw [diagonalShift_exists_iff]
  simp [phaseClass, eq_comm]

/-- A diagonal translation preserves the phase class for every signed time. -/
@[simp] theorem phaseClass_diagonalShift (w h : Nat) (hw : 0 < w) (hh : 0 < h)
    (t : Int) (p : Position w h) :
    phaseClass w h (diagonalShift w h hw hh t p) = phaseClass w h p :=
  ((diagonalShift_exists_iff w h hw hh p _).mp ⟨t, rfl⟩).symm

/-- One cyclic east step raises the phase class by one modulo gcd. -/
theorem phaseClass_east (w h : Nat) (hw : 0 < w) (p : Position w h) :
    phaseClass w h ((eastDirection w h hw).next p) =
      (phaseClass w h p + 1) % Nat.gcd w h := by
  have hm := Nat.mod_mod_of_dvd (p.1.val + 1) (Nat.gcd_dvd_left w h)
  have ha := congrArg (fun k => (k + p.2.val) % Nat.gcd w h) hm
  simp only [Nat.mod_add_mod] at ha
  change ((cyclicNext w hw p.1).val + p.2.val) % Nat.gcd w h = _
  rw [cyclicNext_val]
  change ((p.1.val + 1) % w + p.2.val) % Nat.gcd w h =
    ((p.1.val + p.2.val) % Nat.gcd w h + 1) % Nat.gcd w h
  rw [ha, Nat.mod_add_mod]
  congr 1
  omega

/-- The translated coset (1,0)+<(1,-1)> is exactly the phase-one fiber,
with 1 reduced modulo gcd (so the coprime case remains correct). -/
theorem east_diagonalShift_exists_iff (w h : Nat) (hw : 0 < w) (hh : 0 < h)
    (p q : Position w h) :
    (∃ t : Int, diagonalShift w h hw hh t ((eastDirection w h hw).next p) = q) ↔
      phaseClass w h q = (phaseClass w h p + 1) % Nat.gcd w h := by
  rw [diagonalShift_exists_iff, phaseClass_east]
  exact eq_comm

theorem phaseClass_lt (w h : Nat) (hw : 0 < w) (p : Position w h) :
    phaseClass w h p < Nat.gcd w h :=
  Nat.mod_lt _ (Nat.gcd_pos_of_pos_left h hw)

/-- Every residue class is realized by a torus position. Together with the
orbit criterion, this identifies all diagonal orbits without missing fibers. -/
theorem phaseClass_surjective (w h : Nat) (hw : 0 < w) (hh : 0 < h)
    (c : Fin (Nat.gcd w h)) : ∃ p : Position w h, phaseClass w h p = c.val := by
  have hc : c.val < w := Nat.lt_of_lt_of_le c.isLt (Nat.gcd_le_left h hw)
  refine ⟨(⟨c.val, hc⟩, ⟨0, hh⟩), ?_⟩
  simp [phaseClass, Nat.mod_eq_of_lt c.isLt]

/-- Coprime side lengths give a single signed diagonal orbit. -/
theorem diagonalShift_transitive_of_coprime (w h : Nat) (hw : 0 < w) (hh : 0 < h)
    (hg : Nat.gcd w h = 1) (p q : Position w h) :
    ∃ t : Int, diagonalShift w h hw hh t p = q := by
  apply (diagonalShift_exists_iff w h hw hh p q).mpr
  simp only [phaseClass, hg]
  omega

end BML
